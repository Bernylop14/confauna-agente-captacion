# Copia este archivo como ".env" (sin .example) y rellena los datos.
# El archivo .env NO se comparte con nadie ni se sube a ningún sitio.

# --- Cuenta de correo desde la que se envía ---
# Con Gmail personal (de momento):
EMAIL_USER=tu_correo@gmail.com
# Contraseña de APLICACIÓN (no la normal). En Gmail son 16 letras.
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com

# Google Workspace (correo con dominio propio en Google): NO admite contraseñas. Usa OAuth:
# EMAIL_USER=info@tudominio.es
# EMAIL_AUTH=oauth
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# (y SMTP_HOST/SMTP_PORT/IMAP_HOST como arriba). Guía paso a paso: GUIA_GOOGLE_OAUTH.md

# Otro proveedor con dominio propio (ejemplo con Zoho de pago), cambia las 5 líneas de arriba por:
# EMAIL_USER=info@tudominio.es
# EMAIL_PASSWORD=la_contraseña_de_aplicacion
# SMTP_HOST=smtp.zoho.eu
# SMTP_PORT=465
# IMAP_HOST=imap.zoho.eu
# (los servidores exactos los da tu proveedor en su panel)

# --- Datos que salen en la firma ---
REMITENTE_NOMBRE=Nombre Apellido
TELEFONO=600 000 000
EMPRESA=ConFauna

# --- Límites prudentes ---
LIMITE_DIARIO=20
PAUSA_MIN_SEG=45
PAUSA_MAX_SEG=90
DIAS_RECORDATORIO=7
# Calentamiento: el primer día manda 5 y sube 2 cada día hasta LIMITE_DIARIO (SI/NO)
CALENTAMIENTO=SI
# El autopiloto solo envía de lunes a viernes en este horario
HORA_INICIO=9
HORA_FIN=19
